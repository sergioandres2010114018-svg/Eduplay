rules_version = '2';
// Reglas de Cloud Firestore para el prototipo (PMV) de EduPlay.
// La app inicia sesión anónima en Firebase; solo los dispositivos con la app pueden leer y escribir.
service cloud.firestore {
  match /databases/{database}/documents {

    // Cuentas de estudiantes (nombre, grado, puntos, progreso, insignias).
    match /usuarios/{usuarioId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.id == usuarioId
        && request.resource.data.puntos == 0;
      allow update: if request.auth != null
        && request.resource.data.id == resource.data.id
        && request.resource.data.hash == resource.data.hash;
      allow delete: if false;
    }

    // Biblioteca: fotos, videos y enlaces.
    match /recursos/{recursoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.tipo in ['foto', 'video', 'enlace']
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() <= 90;
      allow update, delete: if false; // Se moderan desde la consola de Firebase.
    }
  }
}
